#!/bin/sh

set -u

: "${MOCK_DIR:?MOCK_DIR is required}"
mkdir -p "$MOCK_DIR/containers"
printf '%s\n' "$*" >> "$MOCK_DIR/commands.log"

command_name=${1:-}
[ "$#" -gt 0 ] && shift

case "$command_name" in
  pull)
    [ "${MOCK_PULL_FAIL:-false}" = true ] && exit 1
    exit 0
    ;;
  image)
    subcommand=${1:-}
    [ "$#" -gt 0 ] && shift
    case "$subcommand" in
      inspect)
        format=
        if [ "${1:-}" = "--format" ]; then
          format=$2
          shift 2
        fi
        case "$format" in
          *RepoDigests*)
            printf '%s\n' "ghcr.io/allen141/thermostat@sha256:mock"
            ;;
          *)
            printf '%s\n' "${MOCK_NEW_IMAGE_ID:-sha256:new}"
            ;;
        esac
        ;;
      rm)
        exit 0
        ;;
      *)
        exit 2
        ;;
    esac
    ;;
  inspect)
    if [ "${1:-}" = "--format" ]; then
      format=$2
      name=$3
      file="$MOCK_DIR/containers/$name"
      [ -f "$file" ] || exit 1
      image_id=$(cat "$file")
      case "$format" in
        *".Image"*)
          printf '%s\n' "$image_id"
          ;;
        *)
          if [ "$name" = "thermostat-monitor-smoke" ] &&
             [ "${MOCK_SMOKE_FAIL:-false}" = true ]; then
            printf '%s\n' "unhealthy"
          elif [ "$name" = "thermostat-monitor" ] &&
               [ "${MOCK_PRODUCTION_FAIL:-false}" = true ] &&
               [ "$image_id" = "${MOCK_NEW_IMAGE_ID:-sha256:new}" ]; then
            printf '%s\n' "unhealthy"
          else
            printf '%s\n' "healthy"
          fi
          ;;
      esac
    else
      [ -f "$MOCK_DIR/containers/${1:-}" ]
    fi
    ;;
  run)
    name=
    image_id=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --detach)
          shift
          ;;
        --name|--network|--restart|--security-opt|--cap-drop|--log-opt|--env|--volume)
          [ "$1" = "--name" ] && name=$2
          shift 2
          ;;
        *)
          image_id=$1
          shift
          ;;
      esac
    done
    [ -n "$name" ] || exit 2
    if [ "$name" = "thermostat-monitor" ] &&
       [ "${MOCK_PRODUCTION_RUN_FAIL:-false}" = true ]; then
      exit 1
    fi
    printf '%s\n' "$image_id" > "$MOCK_DIR/containers/$name"
    printf '%s\n' "mock-container-id"
    ;;
  rm)
    name=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --force)
          shift
          ;;
        *)
          name=$1
          shift
          ;;
      esac
    done
    [ -n "$name" ] && rm -f "$MOCK_DIR/containers/$name"
    ;;
  stop)
    name=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --time)
          shift 2
          ;;
        *)
          name=$1
          shift
          ;;
      esac
    done
    [ -f "$MOCK_DIR/containers/$name" ]
    ;;
  rename)
    mv "$MOCK_DIR/containers/$1" "$MOCK_DIR/containers/$2"
    ;;
  start)
    [ -f "$MOCK_DIR/containers/$1" ]
    printf '%s\n' "$1"
    ;;
  logs)
    printf '%s\n' "mock container log"
    ;;
  *)
    printf '%s\n' "Unsupported mock docker command: $command_name $*" >&2
    exit 2
    ;;
esac
